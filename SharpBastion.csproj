<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.3.26207.106" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.3.26207.106" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Domain\DiffFormatter.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Config\*.md" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>